@startuml
title ShadeNav v0 (MVP) — System Use Cases (Specific, non-business)
!include docs/uml/theme.puml
skinparam Linetype polyline

together {
    ' ========= Primary Actors =========
    actor "Worker" as Worker
    actor "Courier" as Courier
    actor "Tourist" as Tourist
}

together {
    ' ========= External Data Actors =========
    actor "Map \nServices" as Tiles <<external>>
    actor "Meteo \nSources" as WX <<external>>
    actor "Local \nOpen Data" as OD <<external>>
}

together {
    ' ========= Use Cases =========
    ' ---- Core Use Cases ----
    usecase "M1 Define Trip\n(A→B or list of stops)" as M1
    usecase "M2 Get Shade-Aware Alternatives\n(minimize heat exposure)" as M2
    usecase "M3 Select Route & View Guidance\n(map + step overview)" as M3
    usecase "M4 Update Environmental Context\n(weather, shade, water points)" as M4

    ' ---- Worker Missions ----
    usecase "M5 Limit Route Deviation\nfrom Fastest Option" as M5
    usecase "M6 Prioritize Efficiency\nover Max Comfort" as M6

    ' ---- Courier Mission ----
    usecase "M7 Input Multiple Stops\n(for delivery routes)" as M7

    ' ---- Tourist Mission ----
    usecase "M8 Insert Break Stops\ninto Route (rest or explore)" as M8

    ' M1 -[hidden]d- M2
    ' M2 -[hidden]d- M3
    ' M3 -[hidden]d- M4
    ' M4 -[hidden]d- M5
    ' M5 -[hidden]d- M6
    ' M6 -[hidden]d- M7
    ' M7 -[hidden]d- M8
}

left to right direction
' ========= Actor ↔ Use Case Associations =========
' -- Shared Core --
Worker  --> M1
Worker  --> M2
Worker  --> M3

Courier --> M1
Courier --> M2
Courier --> M3

Tourist --> M1
Tourist --> M2
Tourist --> M3

' -- Context Update --
M2 .> M4 : <<include>>\n(data layers refreshed)

' -- Worker specifics --
Worker --> M5
Worker --> M6

' -- Courier specifics --
Courier --> M7

' -- Tourist specifics --
Tourist --> M8

' ========= External actors interact with context updater =========
M2 <-- Tiles
M2 <-- WX
M2 <-- OD

M4 <-- Tiles
M4 <-- WX
M4 <-- OD
@enduml
