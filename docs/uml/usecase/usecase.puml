@startuml
!include docs/uml/theme.puml
title ShadeNav v0 Use Case Diagram
left to right direction
skinparam Linetype polyline

' ========= Main Actors =========
actor "Young Pedestrian" as YoungPedestrian
actor "Worker" as Worker
actor "Parent\n(with kids)" as Parent
actor "Courier\nby foot" as Courier
actor "Tourist" as Tourist

' ========= External Actors =========
actor "Map \nServices" as Tiles
actor "Meteo \nSources" as WX
actor "Local \nOpen Data" as OD

' ========= Use Cases =========
' ---- Business-level use cases (keep it simple) ----
usecase "UC1: Safe return to home" as UC1
usecase "UC2: Commute to Work\n(less heat fatigue, minimal detours)" as UC2
usecase "UC3: Evening Walk to Park\n(shade + nearby water points)" as UC3
usecase "UC4: Foot Deliveries\n(multiple stops, compare fastest vs freshest)" as UC4
usecase "UC5: Tourist Stroll\n(keep planned route, reduce exposure)" as UC5

' ========= Associations (personas -> business UCs) =========
YoungPedestrian --> UC1
Worker  --> UC2
Parent  --> UC3
Courier --> UC4
Tourist --> UC5

' ========= External actors interact with shared UC =========
UC1 <-- Tiles
UC1 <.. WX : possible weather alerts
UC1 <-- OD

UC2 <-- Tiles
UC2 <-- WX
UC2 <-- OD

UC3 <-- Tiles
UC3 <-- WX
UC3 <-- OD

UC4 <-- Tiles
UC4 <-- WX
UC4 <-- OD

UC5 <-- Tiles
UC5 <-- WX
UC5 <-- OD

@enduml
