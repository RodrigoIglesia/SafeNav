@startuml
title SafeNav — System Interfaces Architecture
left to right direction
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam shadowing false
skinparam defaultFontSize 14
skinparam defaultTextAlignment center

' === External Actor ===
actor "User" as User

' === SafeNav System ===
package "SafeNav System" as SafeNav {

  component "User Interface\n(UI)" as UI
  component "Routing Engine\n(RE)" as RE
  component "Context Analyzer\n(CA)" as CA
  component "Data Management\n(DM)" as DM

  ' Internal Interfaces (I1–I7)
  User --> UI : I1 — Route request
  RE --> UI : I2 — Route results
  RE --> CA : I3 — Route candidates
  CA --> RE : I4 — Route scores
  CA --> DM : I5 — Context data request
  RE --> DM : I6 — Map data request
  UI --> CA : I7 — Alerts / Context (optional)
}

' === External Systems ===
package "External Data Sources" {
  [Map Services\n(MapAPI)] as MapAPI
  [Meteo Sources\n(MeteoAPI)] as MeteoAPI
  [Local Open Data\n(OpenDataAPI)] as OpenDataAPI
}

' === External Interfaces (E1–E3) ===
DM --> MapAPI : E1 — Map data
DM --> MeteoAPI : E2 — Weather data
DM --> OpenDataAPI : E3 — Urban open data

' === Layout hints (align external systems) ===
together {
  MapAPI -[hidden]-> MeteoAPI
  MeteoAPI -[hidden]-> OpenDataAPI
}

' === Notes for clarity ===
note top of UI
**I1/I2** — Comunicación con el usuario\n(Route request, route results)
end note

note right of RE
**I3/I4/I6** — Coordina rutas y datos\ncon CA y DM
end note

note right of CA
**I5/I7** — Solicita contexto y\nemite alertas ambientales
end note

note right of DM
**E1–E3** — Integración con APIs externas\n(Map, Meteo, Open Data)
end note

@enduml
