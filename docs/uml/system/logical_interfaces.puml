@startuml
!include docs/uml/theme.puml
skinparam linetype ortho
skinparam shadowing false
skinparam defaultTextAlignment center
skinparam defaultFontSize 12
skinparam ArrowFontSize 11
skinparam nodesep 80
skinparam ranksep 120
allowmixing

left to right direction

' === External UI (Client) ===
component "User Interface System" <<system>> as UISys {
  component "User Interface" as UI
}
interface "I_HTTP_Routes" as IHTTP
IHTTP : + routeRequest(request : RouteRequest) : RouteResponse
UI -down- IHTTP : HTTP/JSON

interface "I_HTTP_Map" as IHTTPMap
IHTTPMap : + mapRequest(request : mapRequest) : MapDataResponse
UI -down- IHTTPMap : HTTP/JSON

' === SafeNav Core ===
component "SafeNav Core" <<system>> as Core {
  
  component "API Layer\n(HTTP Controller)" as API
  IHTTP -- API : implements
  IHTTPMap -- API : implements

  component "Routing Engine\n(RE)" as RE
  interface "I_RoutingService" as IRoute
  IRoute : + getRoute(id : String) : RouteCandidates
  IRoute : + getRouteScores(id : String) : RouteScores
  API --> IRoute
  IRoute -- RE : implements

  component "Context Analyzer\n(CA)" as CA
  interface "I_ContextService" as IContext
  IContext : + evaluateRoutes(routes : RouteCandidates) : RouteScores
  RE -right-> IContext : uses
  IContext -right- CA : implements

  component "Data Management (DM)" as DM
  interface "I_RoadGraphAccess" as IGraph
  IGraph : + getGraphData(area : Area) : GraphData
  interface "I_MapViewService" as IMapView
  IMapView : + getMapView(area : Area) : MapData
  interface "I_ContextDataAccess" as IData
  IData : + getWeatherData(time : DateTime) : WeatherData
  IData : + getUrbanData(area : Area) : UrbanData

  RE --> IGraph : uses
  CA --> IData : uses
  API --> IMapView : uses

  IGraph -- DM : implements
  IMapView -- DM : implements
  IData -- DM : implements
}

' === External Data Sources ===
package "External Data Sources" as External {
  top to bottom direction
  component "Map Services (MapAPI)" <<external>> as MapAPI
  component "Meteo Sources (MeteoAPI)" <<external>> as MeteoAPI
  component "Local Open Data (OpenDataAPI)" <<external>> as OpenDataAPI
}

' === External interfaces implemented by DM ===
interface "I_MapDataAccess" as IMapData
IMapData : + fetchMapData(area : Area) : MapDataResponse
interface "I_MeteoDataAccess" as IMeteoData
IMeteoData : + fetchWeatherData(area : Area, time : DateTime) : WeatherResponse
interface "I_OpenDataAccess"  as IOpenData
IOpenData : + fetchUrbanData(area : Area, dataType : String) : OpenDataResponse

DM -- IMapData : implements
DM -- IMeteoData : implements
DM -- IOpenData : implements

IMapData -- MapAPI : E1: Map data
IMeteoData -- MeteoAPI : E2: Weather data
IOpenData -- OpenDataAPI : E3: Urban data

@enduml
