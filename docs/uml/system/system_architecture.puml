@startuml
!include docs/uml/theme.puml
skinparam linetype ortho
skinparam defaultTextAlignment center

' === SafeNav System ===
package "SafeNav System" as SafeNav {

  component "User Interface\n(UI)" as UI
  component "Routing Engine\n(RE)" as RE
  component "Context Analyzer\n(CA)" as CA
  component "Data Management\n(DM)" as DM

  ' === Internal Interfaces ===
  UI --> RE : I1: Route request
  RE --> UI : I2: Route candidates to show -- User selects the route
  RE --> CA : I3: Route candidates for evaluation
  CA --> UI : I4: Scored routes
  CA --> DM : I5: Context data request
  RE --> DM : I6: Map data request  
  UI --> CA : I7: Alerts/Context (optional)
}

' === External Systems ===
' Place them vertically aligned with DM for clarity
package "External Data Sources" {
  [Map Services\n(MapAPI)] as MapAPI
  [Meteo Sources\n(MeteoAPI)] as MeteoAPI
  [Local Open Data\n(OpenDataAPI)] as OpenDataAPI
}

' === External Interfaces ===
MapAPI --> DM : E1: Map data
MeteoAPI --> DM : E2: Weather data
OpenDataAPI --> DM : E3: Urban open data

@enduml
