@startuml
!include docs/uml/theme.puml
skinparam linetype ortho
skinparam shadowing false
skinparam defaultTextAlignment center
skinparam defaultFontSize 12
skinparam ArrowFontSize 11
skinparam nodesep 100
skinparam ranksep 120

' === Subsystems ===
component "SafeNav System" as SafeNav {
  component "User Interface Subsystem" as UI
  component "SafeNav Backend Subsystem" as CoreSystem
}

package "External Data Sources" as External {
  component "Map Services\n(MapAPI)" <<external>> as MapAPI
  component "Meteo Sources\n(MeteoAPI)" <<external>> as MeteoAPI
  component "Local Open Data\n(OpenDataAPI)" <<external>> as OpenDataAPI
}

' === Interactions ===
UI --> CoreSystem : HTTP/REST API\n(Route requests & results)
CoreSystem --> UI : Responses (routes, alerts, scores)
UI --> MapAPI : Request map to show (Leaflet)

CoreSystem --> [MapAPI] : Map & street data
CoreSystem --> [MeteoAPI] : Weather data
CoreSystem --> [OpenDataAPI] : Urban & POI data

@enduml
